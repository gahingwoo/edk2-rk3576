#!/usr/bin/env python3
"""Cheap drift check for the Markdown docs of this repository.

Fails (exit 1) on:
  * relative links (Markdown or HTML) to files that do not exist;
  * paths in `backticks` that start with a top-level entry of this
    repository (`scripts/...`, `docs/...`) and do not exist;
  * em or en dashes (U+2014, U+2013) anywhere in a .md file;
  * with --edk2: Pcd names, and DEFINE-style names in backticks, that are
    not defined anywhere outside the docs.

Only tracked .md files are read (git ls-files), minus the prefixes given with
--exclude.  Names that are real but live outside the repository (a U-Boot
path, a Windows inbox file) go in .docs-check-ignore, one fnmatch pattern per
line; lines starting with # are comments.

The same script is copied into edk2-rk3576, maskrom-studio, woa-rk3576 and
wddm-mali-g52.  Keep the copies identical; repository differences go in
flags and in .docs-check-ignore.

Usage: scripts/check-docs [--edk2] [--exclude PREFIX ...]
(tools/check-docs in woa-rk3576 and wddm-mali-g52)
"""

import argparse
import fnmatch
import os
import re
import subprocess
import sys
from urllib.parse import unquote

ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      capture_output=True, text=True, check=True).stdout.strip()

# A path in backticks shortly after one of these names is that project's,
# not this repository's ("Linux `drivers/spi/spi-rockchip.c`",
# "wddm-mali-g52 `docs/USBC-DP.md`").  More names: "external NAME" lines in
# .docs-check-ignore.
EXTERNAL = {
    "Linux", "kernel", "mainline", "U-Boot", "TF-A", "Mesa", "mesa", "MPP", "OpenBSD", "Armbian",
    "armbian/build", "TianoCore", "edk2-rockchip", "edk2-rk3576", "woa-rk3576", "woa-rk3576-npu",
    "wddm-mali-g52", "maskrom-studio", "edk2-webflash", "worproject", "Radxa", "Rockchip", "vendor",
    "Vulkan-Loader",
}

DASHES = {"\u2013": "en dash", "\u2014": "em dash"}

FENCE = re.compile(r"^\s*(```|~~~)")
MD_LINK = re.compile(r"!?\[(?:[^\[\]]|\[[^\]]*\])*\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)")
REF_LINK = re.compile(r"^\s*\[[^\]]+\]:\s*<?(\S+?)>?(?:\s+.*)?$")
HTML_LINK = re.compile(r"""(?:href|src)\s*=\s*["']([^"']+)["']""")
CODE_SPAN = re.compile(r"(`+)(.+?)\1")
PCD = re.compile(r"\b(Pcd[A-Z][A-Za-z0-9_]*)(?:\{([\w,]+)\}(\w*))?")
DEFINE = re.compile(r"^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$")
SCHEME = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")


def git_files():
    out = subprocess.run(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=ROOT,
                         capture_output=True, check=True).stdout
    return [f for f in out.decode().split("\0") if f]


def load_ignore():
    pats = []
    global EXTERNAL
    p = os.path.join(ROOT, ".docs-check-ignore")
    if os.path.exists(p):
        for line in open(p, encoding="utf-8"):
            line = line.strip()
            if line.startswith("external "):
                EXTERNAL = EXTERNAL | {line.split(None, 1)[1]}
            elif line and not line.startswith("#"):
                pats.append(line)
    return pats


def ignored(token, pats):
    return any(fnmatch.fnmatchcase(token, p) for p in pats)


def split_fences(text):
    """Yield (lineno, line, in_fence) for every line."""
    in_fence = None
    for n, line in enumerate(text.split("\n"), 1):
        m = FENCE.match(line)
        if m:
            if in_fence is None:
                in_fence = m.group(1)
                yield n, line, True
                continue
            if m.group(1) == in_fence:
                in_fence = None
                yield n, line, True
                continue
        yield n, line, in_fence is not None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--edk2", action="store_true",
                    help="also check Pcd and DEFINE names")
    ap.add_argument("--exclude", action="append", default=[],
                    help="path prefix of .md files not to check")
    args = ap.parse_args()

    files = git_files()
    tracked = set(files)
    tracked_dirs = set()
    for f in files:
        parts = f.split("/")
        for i in range(1, len(parts)):
            tracked_dirs.add("/".join(parts[:i]))
    top = {f.split("/")[0] for f in files}
    pats = load_ignore()

    def exists(rel):
        rel = os.path.normpath(rel).replace(os.sep, "/")
        return rel in tracked or rel in tracked_dirs or \
            os.path.exists(os.path.join(ROOT, rel))

    docs = [f for f in files if f.endswith(".md")
            and not any(f.startswith(x) for x in args.exclude)]

    corpus = None
    if args.edk2:
        # Everything outside the docs that can define a name.
        chunks = []
        for f in files:
            if f.endswith(".md") or f.startswith("docs/"):
                continue
            p = os.path.join(ROOT, f)
            try:
                if os.path.getsize(p) > 4 << 20:
                    continue
                chunks.append(open(p, encoding="utf-8", errors="ignore").read())
            except OSError:
                pass
        # A checked-out TianoCore submodule counts too, when it is there.
        te = os.path.join(ROOT, "third_party", "edk2")
        if os.path.isdir(os.path.join(te, "MdeModulePkg")):
            for dp, _, fns in os.walk(te):
                for fn in fns:
                    if fn.endswith((".dec", ".dsc", ".fdf", ".inf")):
                        chunks.append(open(os.path.join(dp, fn),
                                           encoding="utf-8", errors="ignore").read())
        corpus = "\n".join(chunks)
    defined_cache = {}

    def defined(name):
        if name not in defined_cache:
            defined_cache[name] = re.search(r"\b" + re.escape(name) + r"\b",
                                            corpus) is not None
        return defined_cache[name]

    errors = []

    def err(f, n, msg):
        errors.append(f"{f}:{n}: {msg}")

    for f in docs:
        path = os.path.join(ROOT, f)
        if not os.path.exists(path):
            continue
        text = open(path, encoding="utf-8").read()
        here = os.path.dirname(f)
        prev = ""
        for n, line, in_fence in split_fences(text):
            before, prev = prev, line
            for ch, name in DASHES.items():
                if ch in line:
                    err(f, n, f"{name} (U+{ord(ch):04X}); use a comma, colon, "
                              "parentheses, 'to' or a hyphen")
            if args.edk2:
                for m in PCD.finditer(line):
                    # PcdA{B,C}D is shorthand for PcdABD and PcdACD
                    names = [m.group(1) + x + (m.group(3) or "") for x in m.group(2).split(",")] \
                        if m.group(2) else [m.group(1)]
                    for name in names:
                        if not ignored(name, pats) and not defined(name):
                            err(f, n, f"{name} is not defined anywhere outside the docs")
            if in_fence:
                continue
            # links
            targets = [m.group(1) for m in MD_LINK.finditer(line)]
            targets += [m.group(1) for m in HTML_LINK.finditer(line)]
            m = REF_LINK.match(line)
            if m:
                targets.append(m.group(1))
            for t in targets:
                if SCHEME.match(t) or t.startswith(("#", "//")):
                    continue
                t2 = unquote(t.split("#", 1)[0].split("?", 1)[0])
                if not t2:
                    continue
                rel = t2.lstrip("/") if t2.startswith("/") else os.path.join(here, t2)
                if not exists(rel) and not ignored(t2, pats):
                    err(f, n, f"link to a file that does not exist: {t}")
            # code spans
            # [`path`](https://...) names another project's file: the link
            # says whose.
            stripped = re.sub(r"\[[^\]]*\]\((?:[A-Za-z][\w+.-]*:|//)[^)]*\)", "", line)
            stripped = re.sub(r"\]\([^)]*\)", "]", stripped)
            for m in CODE_SPAN.finditer(stripped):
                tok = m.group(2).strip()
                context = re.findall(r"[\w./'-]+", (before + " " + stripped[:m.start()])[-80:])
                if any(w.rstrip(".,;:").removesuffix("'s") in EXTERNAL for w in context):
                    continue
                if args.edk2 and DEFINE.match(tok):
                    if not ignored(tok, pats) and not defined(tok):
                        err(f, n, f"`{tok}` is not defined anywhere outside the docs")
                    continue
                tok = re.sub(r":\d+(?:-\d+)?(?:,\d+)*$", "", tok)
                tok = re.sub(r"^\./", "", tok).rstrip("/")
                if not tok or re.search(r"[\s<>*?{}$|=\\'\"`()\[\],;~]", tok) \
                        or tok.startswith(("/", "-")) or "://" in tok \
                        or (tok.startswith(".") and not tok.startswith("../")):
                    continue
                if ignored(tok, pats):
                    continue
                if "/" in tok:
                    first = tok.split("/")[0]
                    if first == "..":
                        if not exists(os.path.join(here, tok)):
                            err(f, n, f"`{tok}` does not exist")
                    elif first in top:
                        if not exists(tok) and not exists(os.path.join(here, tok)):
                            err(f, n, f"`{tok}` does not exist in the repository")

    for e in errors:
        print(e)
    print(f"check-docs: {len(docs)} files, {len(errors)} problem(s)")
    if errors:
        print("Fix the docs, or add a name that is real but outside the "
              "repository to .docs-check-ignore.")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
