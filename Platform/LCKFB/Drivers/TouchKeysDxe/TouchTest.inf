[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = TouchTest
  FILE_GUID                      = 9b3d1c52-47a8-4e0f-a26d-3f8015c47e29
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = TouchTestMain

[Sources]
  TouchTest.c
  TouchKeys.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseMemoryLib
  DebugLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib

[Protocols]
  gEfiAbsolutePointerProtocolGuid
  gEfiDevicePathProtocolGuid
  gEfiGraphicsOutputProtocolGuid
