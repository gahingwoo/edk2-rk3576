#include <Guid/HiiPlatformSetupFormset.h>
#include "DebugReportFormSet.h"

formset
  guid      = DEBUG_REPORT_FORMSET_GUID,
  title     = STRING_TOKEN(STR_FORMSET_TITLE),
  help      = STRING_TOKEN(STR_FORMSET_HELP),
  classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,

  form formid = DEBUG_REPORT_FORM_ID,
    title = STRING_TOKEN(STR_FORMSET_TITLE);

    subtitle text = STRING_TOKEN(STR_INTRO_1);
    subtitle text = STRING_TOKEN(STR_INTRO_2);
    subtitle text = STRING_TOKEN(STR_INTRO_3);
    subtitle text = STRING_TOKEN(STR_INTRO_4);
    subtitle text = STRING_TOKEN(STR_NULL);

    text
      help  = STRING_TOKEN(STR_SAVE_ALL_HELP),
      text  = STRING_TOKEN(STR_SAVE_ALL),
      flags = INTERACTIVE,
      key   = DEBUG_REPORT_QUESTION_ALL;

    text
      help  = STRING_TOKEN(STR_SAVE_QUICK_HELP),
      text  = STRING_TOKEN(STR_SAVE_QUICK),
      flags = INTERACTIVE,
      key   = DEBUG_REPORT_QUESTION_QUICK;

  endform;

endformset;
