[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = ZhHansFontDxe
  FILE_GUID                      = 8dbefd8a-b36a-4ff4-a1a3-cef619dd24c3
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ZhHansFontDxeInitialize

[Sources]
  ZhHansFontDxe.c
  ZhHansFontDxe.h
  ZhHansGlyphs.c

[Packages]
