#langdef en-US "English"
#langdef zh-Hans "\wide简体中文\narrow"

#string STR_NULL_STRING                                    #language en-US ""

// The lines with a _LABEL are filled in by AboutUiLib.c as label plus value;
// the text here is what shows when the value cannot be read.
#string STR_ABOUT_FORM_TITLE                               #language en-US "About"
#string STR_ABOUT_FORM_HELP                                #language en-US "Firmware version, board, the hardware the firmware found, and where the firmware comes from."
#string STR_ABOUT_SUBTITLE_FIRMWARE                        #language en-US "Firmware"
#string STR_ABOUT_SUBTITLE_HARDWARE                        #language en-US "Hardware"
#string STR_ABOUT_SUBTITLE_DETECTED                        #language en-US "Found at boot"
#string STR_ABOUT_SUBTITLE_PROJECT                         #language en-US "Project"
#string STR_ABOUT_FOUND                                    #language en-US "found"
#string STR_ABOUT_NOT_FOUND                                #language en-US "not found"
#string STR_ABOUT_VERSION_LABEL                            #language en-US "Firmware version: "
#string STR_ABOUT_VERSION                                  #language en-US "Firmware version: unknown"
#string STR_ABOUT_BUILD_LABEL                              #language en-US "Built: "
#string STR_ABOUT_BUILD                                    #language en-US "Built: unknown"
#string STR_ABOUT_BOARD_LABEL                              #language en-US "Board: "
#string STR_ABOUT_BOARD                                    #language en-US "Board: unknown"
#string STR_ABOUT_VENDOR_LABEL                             #language en-US "Vendor: "
#string STR_ABOUT_VENDOR                                   #language en-US "Vendor: unknown"
#string STR_ABOUT_CPU_CLOCK_LABEL                          #language en-US "CPU clock: "
#string STR_ABOUT_CPU_CLOCK                                #language en-US "CPU clock: unknown"
#string STR_ABOUT_MEMORY_LABEL                             #language en-US "Memory: "
#string STR_ABOUT_MEMORY                                   #language en-US "Memory: unknown"
#string STR_ABOUT_DISPLAY_LABEL                            #language en-US "Display output: "
#string STR_ABOUT_DISPLAY                                  #language en-US "Display output: unknown"
#string STR_ABOUT_TOUCH_LABEL                              #language en-US "Touch screen: "
#string STR_ABOUT_TOUCH                                    #language en-US "Touch screen: unknown"
#string STR_ABOUT_SOC                                      #language en-US "SoC: Rockchip RK3576"
#string STR_ABOUT_CPU                                      #language en-US "CPU: 4x Cortex-A72 + 4x Cortex-A53"
#string STR_ABOUT_REPO                                     #language en-US "Source code: https://github.com/gahingwoo/edk2-rk3576"
