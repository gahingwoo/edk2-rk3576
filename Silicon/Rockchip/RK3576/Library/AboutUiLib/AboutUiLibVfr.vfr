/** @file
 *
 *  The "About" page.  Read-only: every line is a single text, so the browser
 *  draws it across the prompt and option columns.  AboutUiLib.c fills in the
 *  values per language; see there for where each comes from.
 *
 *  The clock line is the one question: an action, read-only so the cursor
 *  never lands on it, with a callback and a refresh interval of one second.
 *  The browser calls AboutUiLib.c with EFI_BROWSER_ACTION_FORM_OPEN when the
 *  page opens and with EFI_BROWSER_ACTION_RETRIEVE every second while it is
 *  open, and redraws the page after each.  It cannot be hidden: the browser
 *  only runs refresh timers for questions it displays.  An action, like a
 *  text with one string, is drawn across both columns.
 *
 *  Copyright (c) 2026, Jiaxing Hu <gahing@gahingwoo.com>
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

#include "AboutFormSetGuid.h"

formset
  guid      = RK3576_ABOUT_FORMSET_GUID,
  title     = STRING_TOKEN(STR_ABOUT_FORM_TITLE),
  help      = STRING_TOKEN(STR_ABOUT_FORM_HELP),
  classguid = gEfiIfrFrontPageGuid,

  form formid = RK3576_ABOUT_FORM_ID,
    title = STRING_TOKEN(STR_ABOUT_FORM_TITLE);

    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_FIRMWARE);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_VERSION);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_BUILD);
    action
      questionid = RK3576_ABOUT_KEY_CLOCK,
      prompt     = STRING_TOKEN(STR_ABOUT_CLOCK),
      help       = STRING_TOKEN(STR_NULL_STRING),
      flags      = INTERACTIVE | READ_ONLY,
      config     = STRING_TOKEN(STR_NULL_STRING),
      refresh interval = 1
    endaction;
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_LICENSE);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_FONT);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_HARDWARE);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_BOARD);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_VENDOR);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_SOC);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_CPU);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_CPU_CLOCK);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_MEMORY);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_DETECTED);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_DISPLAY);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_TOUCH);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_PROJECT);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_REPO);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_DOCS);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_FLASHER);
  endform;

endformset;
