      text = STRING_TOKEN(STR_ABOUT_BUILD);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_LICENSE);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_FONT);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_HARDWARE);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_BOARD);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_VENDOR);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_SOC);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_CPU);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_CPU_CLOCK);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_MEMORY);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_DETECTED);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_DISPLAY);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_TOUCH);
    subtitle text = STRING_TOKEN(STR_NULL_STRING);
    subtitle text = STRING_TOKEN(STR_ABOUT_SUBTITLE_PROJECT);
    text
      help = STRING_TOKEN(STR_NULL_STRING),
      text = STRING_TOKEN(STR_ABOUT_REPO);
    text
