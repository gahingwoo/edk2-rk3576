#string STR_DISPLAY_FORCE_OUTPUT_PROMPT                    #language en-US "Force Output"
#string STR_DISPLAY_FORCE_OUTPUT_HELP                      #language en-US "Force display output even when no monitor is detected (HPD low). Useful for headless setups or displays that do not assert HPD."

#string STR_DISPLAY_DUPLICATE_OUTPUT_PROMPT                #language en-US "Duplicate Output"
#string STR_DISPLAY_DUPLICATE_OUTPUT_HELP                  #language en-US "Duplicate the primary output to all detected displays."

#string STR_DISPLAY_ROTATION_PROMPT                        #language en-US "Screen Rotation"
#string STR_DISPLAY_ROTATION_HELP                          #language en-US "Rotate the firmware's menus clockwise. Default follows the screen: a MIPI DSI panel is drawn the way it is mounted, HDMI is not rotated. An operating system still gets the screen's own orientation."
#string STR_DISPLAY_ROTATION_0                             #language en-US "Default"
#string STR_DISPLAY_ROTATION_90                            #language en-US "90° Clockwise"
#string STR_DISPLAY_ROTATION_270                           #language en-US "270° Clockwise"
#string STR_DISPLAY_ROTATION_NONE                          #language en-US "0° (None)"
#string STR_DISPLAY_BRIGHTNESS_PROMPT                     #language en-US "Screen Brightness (%)"
#string STR_DISPLAY_BRIGHTNESS_HELP                       #language en-US "Brightness the firmware lights the MIPI DSI screen at, in percent, 10 to 100. An operating system can change it once it runs; Windows saves and restores the level it set itself."

#string STR_HDMI_SIGNALING_MODE_PROMPT                     #language en-US "HDMI Signaling"
#string STR_HDMI_SIGNALING_MODE_HELP                       #language en-US "Choose the HDMI signaling protocol.\n\nAuto - use HDMI if the monitor supports it, otherwise fall back to DVI.\nDVI - force DVI-compatible signaling (no audio, no advanced HDMI features).\nHDMI - force full HDMI signaling."
#string STR_HDMI_SIGNALING_MODE_AUTO                       #language en-US "Auto"
#string STR_HDMI_SIGNALING_MODE_DVI                        #language en-US "DVI"
#string STR_HDMI_SIGNALING_MODE_HDMI                       #language en-US "HDMI"

/*
 * Screenshots (ScreenshotDxe)
 */
#string STR_SCREENSHOT_SUBTITLE                            #language en-US "Screenshots"
#string STR_SCREENSHOT_TARGET_PROMPT                       #language en-US "Save Screenshots To"
#string STR_SCREENSHOT_TARGET_HELP                         #language en-US "Where a screenshot of the display is saved. Take one with Ctrl+Alt+F12 on a keyboard, F12 on the serial console, or the camera icon on the on-screen keyboard. Automatic tries a USB stick first, then an SD card, then the internal storage (eMMC, NVMe). It is saved as \\uefi-screenshots\\YYYYMMDD-HHMMSS.png on a FAT formatted medium, and a green square flashes in the top left corner.\n\nWith one kind of medium chosen, no other is used: when it is missing, a yellow square flashes and nothing is saved. Applies at once."
#string STR_SCREENSHOT_TARGET_ANY                          #language en-US "Automatic (USB stick first)"
#string STR_SCREENSHOT_TARGET_USB                          #language en-US "USB stick only"
#string STR_SCREENSHOT_TARGET_SD                           #language en-US "SD card only"
#string STR_SCREENSHOT_TARGET_INTERNAL                     #language en-US "Internal storage only"

/*
 * ComboPHY mode configuration
 */

#string STR_COMBO_PHY_FORM_TITLE                           #language en-US "ComboPHY Mode"
#string STR_COMBO_PHY_FORM_HELP                            #language en-US "Configure the Naneng Combo PHY controllers."
#string STR_COMBO_PHY_FORM_SUBTITLE                        #language en-US "Changes take effect after reboot."

#string STR_COMBO_PHY0_MODE_PROMPT                         #language en-US "ComboPHY0 (M.2 PCIe)"
#string STR_COMBO_PHY1_MODE_PROMPT                         #language en-US "ComboPHY1 (USB Type-A)"

#string STR_COMBO_PHY_MODE_DEFAULT_PCIE_HELP               #language en-US "Configure PHY mode. Default: PCIe.\n\nUnconnected - disable the PHY (saves power).\nPCIe - standard PCIe lane."
#string STR_COMBO_PHY_MODE_DEFAULT_USB3_HELP               #language en-US "Configure PHY mode. Default: USB 3.0.\n\nUnconnected - disable the PHY.\nPCIe - use as PCIe lane instead of USB3 (loses USB3 SuperSpeed on this port).\nUSB 3.0 - standard SuperSpeed USB."
#string STR_COMBO_PHY_MODE_DEFAULT_UNCONNECTED_HELP        #language en-US "Configure PHY mode. Default: Unconnected.\n\nThe PHY is not connected to any interface on this board."

#string STR_COMBO_PHY_MODE_UNCONNECTED                     #language en-US "Unconnected"
#string STR_COMBO_PHY_MODE_PCIE                            #language en-US "PCIe"
#string STR_COMBO_PHY_MODE_USB3                            #language en-US "USB 3.0"

/*
 * The About page itself is AboutUiLib (Silicon/Rockchip/RK3576/Library), a
 * front page entry of its own; this form only links to it.
 */

#string STR_ABOUT_FORM_TITLE                               #language en-US "About"
#string STR_ABOUT_FORM_HELP                                #language en-US "Firmware version, board, the hardware the firmware found, and where the firmware comes from."

/*
 * Simplified Chinese.
 *
 * Every run of CJK text is bracketed by \wide ... \narrow.  The setup
 * browser counts screen columns from those markers, not from the glyphs,
 * so a CJK character outside them overprints the text that follows.
 * Every string needs a zh-Hans entry, even when it is the same as the
 * English: a missing one is drawn as a lone !, not as English.
 * After changing this text run  scripts/gen-zh-hans-font.py check  and,
 * if it asks for it,  generate  to update the glyphs in ZhHansFontDxe.
 */

#string STR_NULL_STRING                                    #language zh-Hans ""
#string STR_FORM_SET_TITLE                                 #language zh-Hans "RK3576 \wide平台配置\narrow"
#string STR_FORM_SET_TITLE_HELP                            #language zh-Hans "\wide配置\narrow ACPI \wide和设备树系统表支持。\narrow"
#string STR_FORM_SET_TITLE_SUBTITLE                        #language zh-Hans "\wide配置选项\narrow"
#string STR_PLATFORM_CONFIGURATION                         #language zh-Hans "\wide平台配置\narrow"
#string STR_DISABLED                                       #language zh-Hans "\wide禁用\narrow"
#string STR_ENABLED                                        #language zh-Hans "\wide启用\narrow"
#string STR_PLUS_SIGN                                      #language zh-Hans "+"
#string STR_MINUS_SIGN                                     #language zh-Hans "-"
#string STR_CONFIG_TABLE_FORM_TITLE                        #language zh-Hans "ACPI / \wide设备树\narrow"
#string STR_CONFIG_TABLE_FORM_HELP                         #language zh-Hans "\wide配置\narrow ACPI \wide和设备树系统表支持。\narrow"
#string STR_CONFIG_TABLE_MODE_PROMPT                       #language zh-Hans "\wide系统配置表模式\narrow"
#string STR_CONFIG_TABLE_MODE_HELP                         #language zh-Hans "\wide选择向操作系统提供哪种配置表。\narrow\n\n"
                                                                             "ACPI - Windows \wide和\narrow BSD \wide必须使用此项。只提供\narrow ACPI \wide表。\narrow\n\n"
                                                                             "\wide设备树\narrow - \wide针对特定内核版本提供更全面的硬件支持。\narrow\n\n"
                                                                             "\wide两者都提供时由操作系统决定使用哪一种。\narrowLinux \wide优先使用设备树，\narrowWindows \wide只使用\narrow ACPI\wide。\narrow"
#string STR_CONFIG_TABLE_MODE_ACPI                         #language zh-Hans "ACPI"
#string STR_CONFIG_TABLE_MODE_FDT                          #language zh-Hans "\wide设备树\narrow"
#string STR_CONFIG_TABLE_MODE_ACPI_FDT                     #language zh-Hans "\wide两者都提供\narrow"
#string STR_CONFIG_TABLE_ACPI_SUBTITLE                     #language zh-Hans "ACPI \wide配置\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_PROMPT              #language zh-Hans "PCIe ECAM \wide兼容模式\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_HELP                #language zh-Hans "\wide选择如何向操作系统提供非标准的\narrow PCIe \wide配置空间。\narrow\n\n"
                                                                             "\wide自动\narrow - \wide根据操作系统引导程序自动选择最合适的模式。\narrow\n\n"
                                                                             "\wide单设备\narrow - \wide每个总线段只提供一个\narrow PCIe \wide设备（通用的\narrow ECAM \wide规避方案）。\narrow\n\n"
                                                                             "NXPMX6 - \wide使用\narrow NXP i.MX6 \wide的\narrow ECAM quirk\wide。\narrow\n\n"
                                                                             "AMAZON GRAVITON - \wide使用\narrow Amazon Graviton \wide的\narrow ECAM quirk\wide。\narrow"
#string STR_ACPI_FAN_CONTROL_PROMPT                        #language zh-Hans "\wide由\narrow ACPI \wide热区控制风扇\narrow"
#string STR_ACPI_FAN_CONTROL_HELP                          #language zh-Hans "\wide禁用\narrow - \wide风扇保持固件启动时设定的转速，操作系统只能读取温度。\narrow\n\n"
                                                                             "\wide启用\narrow - \wide操作系统通过\narrow ACPI \wide风扇设备随\narrow SoC \wide温度调节风扇转速（\narrowWindows \wide自带支持，无需驱动）。使用设备树的\narrow Linux \wide不受此选项影响。\narrow"
#string STR_ACPI_CPU_IDLE_STATES_PROMPT                    #language zh-Hans "CPU \wide空闲状态\narrow"
#string STR_ACPI_CPU_IDLE_STATES_HELP                      #language zh-Hans "\wide禁用\narrow - \wide操作系统只用\narrow WFI \wide让空闲的核心等待，与没有这个选项时相同。\narrow\n\n"
                                                                             "\wide启用\narrow - \wide向操作系统提供核心掉电空闲状态（\narrowACPI _LPI\wide，经\narrow PSCI CPU_SUSPEND \wide进入，参数与主线\narrow Linux \wide的\narrow CPU_SLEEP \wide相同），降低空闲功耗和温度。尚未在\narrow Windows \wide上验证：掉电时核心的定时器会停，而本芯片没有\narrow Windows \wide可用的常开定时器。如果开机卡住或时钟变慢，请关闭此项。使用设备树的\narrow Linux \wide不受此选项影响。\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_AUTO                #language zh-Hans "\wide自动\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_SINGLE_DEV          #language zh-Hans "\wide单设备\narrow"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_NXPMX6              #language zh-Hans "NXPMX6"
#string STR_ACPI_PCIE_ECAM_COMPAT_MODE_GRAVITON            #language zh-Hans "AMAZON GRAVITON"
#string STR_CONFIG_TABLE_FDT_SUBTITLE                      #language zh-Hans "\wide设备树配置\narrow"
#string STR_FDT_COMPAT_MODE_PROMPT                         #language zh-Hans "\wide兼容模式\narrow"
#string STR_FDT_COMPAT_MODE_HELP                           #language zh-Hans "\wide选择向操作系统提供哪种设备树。\narrow\n\n"
                                                                             "\wide厂商\narrow - \wide仅兼容\narrow Rockchip SDK Linux 6.1 \wide内核。\narrow\n\n"
                                                                             "\wide主线\narrow - \wide兼容通用的上游\narrow Linux 6.10 \wide或更新版本内核。此选项仍在积极开发中，可能缺少部分功能，因此建议始终使用最新的内核和固件，以获得更好的设备支持。\narrow"
#string STR_FDT_COMPAT_MODE_VENDOR                         #language zh-Hans "\wide厂商\narrow"
#string STR_FDT_COMPAT_MODE_MAINLINE                       #language zh-Hans "\wide主线\narrow"
#string STR_FDT_FORCE_GOP_PROMPT                           #language zh-Hans "\wide强制使用\narrow UEFI GOP \wide显示\narrow"
#string STR_FDT_FORCE_GOP_HELP                             #language zh-Hans "\wide在缺少原生显示驱动的旧版\narrow Linux \wide内核上，使用\narrow UEFI GOP \wide提供的基本显示输出（\narrowHDMI/DP/DSI\wide）。\narrow"
#string STR_FDT_SUPPORT_OVERRIDES_PROMPT                   #language zh-Hans "\wide支持替换\narrow DTB \wide和\narrow overlay"
#string STR_FDT_SUPPORT_OVERRIDES_HELP                     #language zh-Hans "\wide启用或禁用替换固件自带\narrow DTB \wide和安装\narrow overlay \wide的功能。\narrow\n\n\wide详情请参阅固件文档。\narrow"
#string STR_FDT_OVERRIDE_SUBTITLE                          #language zh-Hans "DTB \wide替换\narrow"
#string STR_FDT_OVERRIDE_FIXUP_PROMPT                      #language zh-Hans "\wide固件修正\narrow"
#string STR_FDT_OVERRIDE_FIXUP_HELP                        #language zh-Hans "\wide启用或禁用固件对替换\narrow DTB \wide的修正（\narrowfix-up\wide）。\narrow"
#string STR_FDT_OVERRIDE_BASE_PATH_PROMPT                  #language zh-Hans "\wide首选基础\narrow DTB \wide路径\narrow"
#string STR_FDT_OVERRIDE_BASE_PATH_HELP                    #language zh-Hans "\wide输入用于替换基础\narrow DTB \wide的首选文件或目录路径，相对于文件系统根目录。\narrow\n\n"
                                                                             "\wide选定启动设备后，固件会扫描该设备上所有受支持的文件系统（\narrowFAT\wide、\narrowext4\wide），并尝试加载指定的替换文件。\narrow\n\n"
                                                                             "- \wide如果指定的是目录路径，会在其后追加平台\narrow FDT \wide文件名（\narrow<PLATFORM-DT-NAME>\wide）。\narrow\n"
                                                                             "- \wide如果指定的是文件路径，则按原样使用。\narrow\n"
                                                                             "- \wide如果替换文件不存在，则使用固件自带的\narrow DTB\wide。\narrow\n\n"
                                                                             "\wide示例：\narrow\n"
                                                                             " \\dtbs\n"
                                                                             " \\dtbs\\my-board.dtb\n\n"
                                                                             "\wide默认备选路径：\narrow\n"
                                                                             " \\dtb\n"
                                                                             " \\dtb\\base\n"
                                                                             " \\dtb\\rockchip\n\n"
                                                                             "\wide要将此选项恢复为默认值，请将其设为一个空格，保存并重启。\narrow"
#string STR_FDT_OVERRIDE_OVERLAY_PATH_PROMPT               #language zh-Hans "\wide首选\narrow overlay \wide路径\narrow"
#string STR_FDT_OVERRIDE_OVERLAY_PATH_HELP                 #language zh-Hans "\wide输入\narrow DTB overlay \wide的首选目录路径，相对于文件系统根目录。\narrow\n\n"
                                                                             "\wide选定启动设备后，固件会扫描该设备上所有受支持的文件系统（\narrowFAT\wide、\narrowext4\wide），并尝试加载指定目录中的所有\narrow overlay\wide。\narrow\n\n"
                                                                             "- \wide只要有一个\narrow overlay \wide安装失败，其余所有\narrow overlay \wide都会被丢弃。\narrow\n\n"
                                                                             "\wide示例：\narrow\n"
                                                                             " \\my-overlays\n"
                                                                             " \\dtbs\\overlays\n\n"
                                                                             "\wide默认备选路径：\narrow\n"
                                                                             " \\dtb\\overlays\n"
                                                                             " \\dtb\\overlays\\<PLATFORM-DT-NAME>\n\n"
                                                                             "\wide要将此选项恢复为默认值，请将其设为一个空格，保存并重启。\narrow"
#string STR_DISPLAY_FORM_TITLE                             #language zh-Hans "\wide显示\narrow"
#string STR_DISPLAY_FORM_HELP                              #language zh-Hans "\wide配置\narrow HDMI \wide显示输出的分辨率和其他设置。\narrow"
#string STR_DISPLAY_FORM_SUBTITLE                          #language zh-Hans "\wide显示设置\narrow"
#string STR_DISPLAY_MODE_PRESET_PROMPT                     #language zh-Hans "\wide显示模式\narrow"
#string STR_DISPLAY_MODE_PRESET_HELP                       #language zh-Hans "\wide选择显示分辨率和刷新率。\narrow\n\n\wide原生\narrow - \wide使用显示器的首选模式。\narrow\n\wide自定义\narrow - \wide手动指定像素时钟和时序参数。\narrow\n\n\wide更改在重启后生效。\narrow\n\n\wide提示：按\narrow LCtrl+LShift+F6 \wide可将所有显示设置恢复为默认值。\narrow"
#string STR_DISPLAY_MODE_NATIVE                            #language zh-Hans "\wide原生模式（显示器首选）\narrow"
#string STR_DISPLAY_MODE_CUSTOM                            #language zh-Hans "\wide自定义模式\narrow"
#string STR_DISPLAY_MODE_640_480_60                        #language zh-Hans "640x480 @ 60 Hz"
#string STR_DISPLAY_MODE_800_600_60                        #language zh-Hans "800x600 @ 60 Hz"
#string STR_DISPLAY_MODE_1024_768_60                       #language zh-Hans "1024x768 @ 60 Hz"
#string STR_DISPLAY_MODE_1152_864_60                       #language zh-Hans "1152x864 @ 60 Hz"
#string STR_DISPLAY_MODE_1280_720_60                       #language zh-Hans "1280x720 @ 60 Hz"
#string STR_DISPLAY_MODE_1280_768_60                       #language zh-Hans "1280x768 @ 60 Hz"
#string STR_DISPLAY_MODE_1280_800_60                       #language zh-Hans "1280x800 @ 60 Hz"
#string STR_DISPLAY_MODE_1280_960_60                       #language zh-Hans "1280x960 @ 60 Hz"
#string STR_DISPLAY_MODE_1280_1024_60                      #language zh-Hans "1280x1024 @ 60 Hz"
#string STR_DISPLAY_MODE_1360_768_60                       #language zh-Hans "1360x768 @ 60 Hz"
#string STR_DISPLAY_MODE_1400_1050_60                      #language zh-Hans "1400x1050 @ 60 Hz"
