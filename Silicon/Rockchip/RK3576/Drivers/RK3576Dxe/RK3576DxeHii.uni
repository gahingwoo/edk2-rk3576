#string STR_DISPLAY_MODE_1600_1200_60                      #language zh-Hans "1600x1200 @ 60 Hz"
#string STR_DISPLAY_MODE_1680_1050_60                      #language zh-Hans "1680x1050 @ 60 Hz"
#string STR_DISPLAY_MODE_1920_1080_60                      #language zh-Hans "1920x1080 @ 60 Hz (1080p)"
#string STR_DISPLAY_MODE_1920_1200_60                      #language zh-Hans "1920x1200 @ 60 Hz"
#string STR_DISPLAY_MODE_2048_1152_60                      #language zh-Hans "2048x1152 @ 60 Hz"
#string STR_DISPLAY_MODE_2560_1080_60                      #language zh-Hans "2560x1080 @ 60 Hz"
#string STR_DISPLAY_MODE_2560_1440_60                      #language zh-Hans "2560x1440 @ 60 Hz (1440p)"
#string STR_DISPLAY_MODE_2560_1600_60                      #language zh-Hans "2560x1600 @ 60 Hz"
#string STR_DISPLAY_MODE_3440_1440_60                      #language zh-Hans "3440x1440 @ 60 Hz\wide（超宽）\narrow"
#string STR_DISPLAY_MODE_3840_2160_30                      #language zh-Hans "3840x2160 @ 30 Hz (4K)"
#string STR_DISPLAY_MODE_3840_2160_60                      #language zh-Hans "3840x2160 @ 60 Hz (4K)"
#string STR_DISPLAY_MODE_4096_2160_30                      #language zh-Hans "4096x2160 @ 30 Hz (4K DCI)"
#string STR_DISPLAY_MODE_4096_2160_60                      #language zh-Hans "4096x2160 @ 60 Hz (4K DCI)"
#string STR_DISPLAY_MODE_CUSTOM_PIXEL_CLOCK                #language zh-Hans "\wide像素时钟\narrow (kHz)"
#string STR_DISPLAY_MODE_CUSTOM_HORIZONTAL_ACTIVE          #language zh-Hans "\wide水平有效像素\narrow"
#string STR_DISPLAY_MODE_CUSTOM_HORIZONTAL_FRONT_PORCH     #language zh-Hans "\wide水平前沿\narrow"
#string STR_DISPLAY_MODE_CUSTOM_HORIZONTAL_SYNC_WIDTH      #language zh-Hans "\wide水平同步宽度\narrow"
#string STR_DISPLAY_MODE_CUSTOM_HORIZONTAL_BACK_PORCH      #language zh-Hans "\wide水平后沿\narrow"
#string STR_DISPLAY_MODE_CUSTOM_HORIZONTAL_SYNC_POLARITY   #language zh-Hans "\wide水平同步极性\narrow"
#string STR_DISPLAY_MODE_CUSTOM_VERTICAL_ACTIVE            #language zh-Hans "\wide垂直有效行数\narrow"
#string STR_DISPLAY_MODE_CUSTOM_VERTICAL_FRONT_PORCH       #language zh-Hans "\wide垂直前沿\narrow"
#string STR_DISPLAY_MODE_CUSTOM_VERTICAL_SYNC_WIDTH        #language zh-Hans "\wide垂直同步宽度\narrow"
#string STR_DISPLAY_MODE_CUSTOM_VERTICAL_BACK_PORCH        #language zh-Hans "\wide垂直后沿\narrow"
#string STR_DISPLAY_MODE_CUSTOM_VERTICAL_SYNC_POLARITY     #language zh-Hans "\wide垂直同步极性\narrow"
#string STR_DISPLAY_CONNECTORS_PRIORITY_PROMPT             #language zh-Hans "\wide输出优先级\narrow"
#string STR_DISPLAY_CONNECTORS_PRIORITY_HELP               #language zh-Hans "\wide显示输出接口的启用顺序。第一个接有显示器的接口将作为主输出。\narrow"
#string STR_DISPLAY_CONNECTOR_HDMI0                        #language zh-Hans "HDMI0"
#string STR_DISPLAY_CONNECTOR_HDMI1                        #language zh-Hans "HDMI1"
#string STR_DISPLAY_CONNECTOR_EDP0                         #language zh-Hans "eDP0"
#string STR_DISPLAY_CONNECTOR_EDP1                         #language zh-Hans "eDP1"
#string STR_DISPLAY_CONNECTOR_DP0                          #language zh-Hans "DP0"
#string STR_DISPLAY_CONNECTOR_DP1                          #language zh-Hans "DP1"
#string STR_DISPLAY_CONNECTOR_MIPI0                        #language zh-Hans "MIPI0"
#string STR_DISPLAY_CONNECTOR_MIPI1                        #language zh-Hans "MIPI1"
#string STR_DISPLAY_CONNECTOR_TYPE_HDMI                    #language zh-Hans "HDMI \wide设置\narrow"
#string STR_DISPLAY_FORCE_OUTPUT_PROMPT                    #language zh-Hans "\wide强制输出\narrow"
#string STR_DISPLAY_FORCE_OUTPUT_HELP                      #language zh-Hans "\wide即使未检测到显示器（\narrowHPD \wide为低电平）也强制输出。适用于不接显示器的系统，或不拉高\narrow HPD \wide的显示器。\narrow"
#string STR_DISPLAY_DUPLICATE_OUTPUT_PROMPT                #language zh-Hans "\wide复制输出\narrow"
#string STR_DISPLAY_DUPLICATE_OUTPUT_HELP                  #language zh-Hans "\wide将主输出复制到所有检测到的显示器。\narrow"
#string STR_DISPLAY_ROTATION_PROMPT                        #language zh-Hans "\wide屏幕旋转\narrow"
#string STR_DISPLAY_ROTATION_HELP                          #language zh-Hans "\wide将固件菜单顺时针旋转。默认值跟随屏幕：\narrowMIPI DSI \wide面板按其安装方向绘制，\narrowHDMI \wide不旋转。操作系统得到的仍是屏幕本身的方向。\narrow"
#string STR_DISPLAY_ROTATION_0                             #language zh-Hans "\wide默认\narrow"
#string STR_DISPLAY_ROTATION_90                            #language zh-Hans "\wide顺时针\narrow 90°"
#string STR_DISPLAY_ROTATION_270                           #language zh-Hans "\wide顺时针\narrow 270°"
#string STR_DISPLAY_ROTATION_NONE                          #language zh-Hans "0°\wide（不旋转）\narrow"
#string STR_DISPLAY_BRIGHTNESS_PROMPT                     #language zh-Hans "\wide屏幕亮度\narrow (%)"
#string STR_DISPLAY_BRIGHTNESS_HELP                       #language zh-Hans "\wide固件点亮\narrow MIPI DSI \wide屏幕时使用的亮度，单位为\narrow %\wide，从\narrow 10 \wide到\narrow 100\wide。操作系统启动后可以自行调整；\narrowWindows \wide会保存并恢复自行设置的亮度。\narrow"
#string STR_HDMI_SIGNALING_MODE_PROMPT                     #language zh-Hans "HDMI \wide信号模式\narrow"
#string STR_HDMI_SIGNALING_MODE_HELP                       #language zh-Hans "\wide选择\narrow HDMI \wide信号协议。\narrow\n\n\wide自动\narrow - \wide显示器支持\narrow HDMI \wide时使用\narrow HDMI\wide，否则回退到\narrow DVI\wide。\narrow\nDVI - \wide强制使用\narrow DVI \wide兼容信号（无音频，无\narrow HDMI \wide高级功能）。\narrow\nHDMI - \wide强制使用完整的\narrow HDMI \wide信号。\narrow"
#string STR_HDMI_SIGNALING_MODE_AUTO                       #language zh-Hans "\wide自动\narrow"
#string STR_HDMI_SIGNALING_MODE_DVI                        #language zh-Hans "DVI"
#string STR_HDMI_SIGNALING_MODE_HDMI                       #language zh-Hans "HDMI"
#string STR_SCREENSHOT_SUBTITLE                            #language zh-Hans "\wide截图\narrow"
#string STR_SCREENSHOT_TARGET_PROMPT                       #language zh-Hans "\wide截图保存位置\narrow"
#string STR_SCREENSHOT_TARGET_HELP                         #language zh-Hans "\wide显示画面截图的保存位置。截图方法：键盘按\narrow Ctrl+Alt+F12\wide，串口控制台按\narrow F12\wide，或点屏幕键盘上的相机图标。自动：先\narrow U\wide盘，然后\narrow SD \wide卡，最后内部存储（\narrow eMMC\wide、\narrow NVMe\wide）。图片保存为\narrow FAT \wide格式存储设备上的\narrow \\uefi-screenshots\\YYYYMMDD-HHMMSS.png\wide，左上角会闪一下绿色方块。\narrow\n\n\wide只选一种设备时不会改用其他设备：该设备不在时闪黄色方块，不保存。设置立即生效。\narrow"
#string STR_SCREENSHOT_TARGET_ANY                          #language zh-Hans "\wide自动（\narrowU\wide盘优先）\narrow"
#string STR_SCREENSHOT_TARGET_USB                          #language zh-Hans "\wide仅\narrow U\wide盘\narrow"
#string STR_SCREENSHOT_TARGET_SD                           #language zh-Hans "\wide仅\narrow SD \wide卡\narrow"
#string STR_SCREENSHOT_TARGET_INTERNAL                     #language zh-Hans "\wide仅内部存储\narrow"
#string STR_COMBO_PHY_FORM_TITLE                           #language zh-Hans "ComboPHY \wide模式\narrow"
#string STR_COMBO_PHY_FORM_HELP                            #language zh-Hans "\wide配置\narrow Naneng Combo PHY \wide控制器。\narrow"
#string STR_COMBO_PHY_FORM_SUBTITLE                        #language zh-Hans "\wide更改在重启后生效。\narrow"
#string STR_COMBO_PHY0_MODE_PROMPT                         #language zh-Hans "ComboPHY0 (M.2 PCIe)"
#string STR_COMBO_PHY1_MODE_PROMPT                         #language zh-Hans "ComboPHY1 (USB Type-A)"
#string STR_COMBO_PHY_MODE_DEFAULT_PCIE_HELP               #language zh-Hans "\wide配置\narrow PHY \wide模式。默认：\narrowPCIe\wide。\narrow\n\n\wide未连接\narrow - \wide关闭该\narrow PHY\wide（节省功耗）。\narrow\nPCIe - \wide标准\narrow PCIe \wide通道。\narrow"
#string STR_COMBO_PHY_MODE_DEFAULT_USB3_HELP               #language zh-Hans "\wide配置\narrow PHY \wide模式。默认：\narrowUSB 3.0\wide。\narrow\n\n\wide未连接\narrow - \wide关闭该\narrow PHY\wide。\narrow\nPCIe - \wide用作\narrow PCIe \wide通道而非\narrow USB3\wide（此端口将失去\narrow USB3 SuperSpeed\wide）。\narrow\nUSB 3.0 - \wide标准\narrow SuperSpeed USB\wide。\narrow"
#string STR_COMBO_PHY_MODE_DEFAULT_UNCONNECTED_HELP        #language zh-Hans "\wide配置\narrow PHY \wide模式。默认：未连接。\narrow\n\n\wide本板上该\narrow PHY \wide未连接到任何接口。\narrow"
#string STR_COMBO_PHY_MODE_UNCONNECTED                     #language zh-Hans "\wide未连接\narrow"
#string STR_COMBO_PHY_MODE_PCIE                            #language zh-Hans "PCIe"
#string STR_COMBO_PHY_MODE_USB3                            #language zh-Hans "USB 3.0"
#string STR_ABOUT_FORM_TITLE                               #language zh-Hans "\wide关于\narrow"
#string STR_ABOUT_FORM_HELP                                #language zh-Hans "\wide固件版本、板卡、固件检测到的硬件，以及固件的来源。\narrow"
