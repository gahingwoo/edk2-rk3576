[Defines]
  DEC_SPECIFICATION              = 0x00010019
  PACKAGE_NAME                   = RK3576
  PACKAGE_GUID                   = 7a3e1f2c-9b4d-4e8a-b1c5-2f6d8e0a3c7b
  PACKAGE_VERSION                = 0.1

[Includes.common]
  Include

[Guids.common]
  gRK3576TokenSpaceGuid = { 0x7a3e1f2c, 0x9b4d, 0x4e8a, { 0xb1, 0xc5, 0x2f, 0x6d, 0x8e, 0x0a, 0x3c, 0x7b } }
  gRK3576DxeFormSetGuid = { 0x8b4f2e3d, 0xac5e, 0x4f9b, { 0xc2, 0xd6, 0x3e, 0x7e, 0x9f, 0x1b, 0x4d, 0x8c } }

[PcdsFixedAtBuild]
  # RK3576 peripheral base addresses
  gRK3576TokenSpaceGuid.PcdSdhciBaseAddr|0x2A330000|UINT64|0x00020001
  gRK3576TokenSpaceGuid.PcdSdmmcBaseAddr|0x2A310000|UINT64|0x00020002
  gRK3576TokenSpaceGuid.PcdFspiBaseAddr|0x2A340000|UINT64|0x00020003

  # CPU performance presets
  gRK3576TokenSpaceGuid.PcdCPULClusterClockPresetDefault|0|UINT32|0x00010001
  gRK3576TokenSpaceGuid.PcdCPUBClusterClockPresetDefault|0|UINT32|0x00010002

  #
  # CPU cluster clock applied before boot, in Hz.  0 leaves the rate the
  # firmware was handed.
  #
  # These are bounded by the voltage on vdd_cpu_lit_s0 / vdd_cpu_big_s0, not
  # by the silicon.  Nothing in the firmware raises those rails at boot (the
  # boards' RK806 init tables have no caller), so they are at the PMIC's
  # power-on defaults.  mainline's OPP tables in rk3576.dtsi pair each rate
  # with a minimum voltage, and going above the configured rate without
  # raising the rail first is an undervolt.  PcdCpuMaxFreq is the one path
  # that does both, in that order.
  #
  gRK3576TokenSpaceGuid.PcdCPULClusterClockHz|0|UINT64|0x00010003
  gRK3576TokenSpaceGuid.PcdCPUBClusterClockHz|0|UINT64|0x00010004

  # ComboPHY (RK3576 has 2 combo PHYs: combphy0_ps, combphy1_psu)
  gRK3576TokenSpaceGuid.PcdComboPhy0Switchable|FALSE|BOOLEAN|0x00010101
  gRK3576TokenSpaceGuid.PcdComboPhy1Switchable|FALSE|BOOLEAN|0x00010102
  gRK3576TokenSpaceGuid.PcdComboPhy0ModeDefault|0|UINT32|0x00010104
  gRK3576TokenSpaceGuid.PcdComboPhy1ModeDefault|0|UINT32|0x00010105

  # Config table mode (ACPI / FDT)
  gRK3576TokenSpaceGuid.PcdConfigTableModeDefault|0|UINT32|0x00010300
  gRK3576TokenSpaceGuid.PcdAcpiPcieEcamCompatModeDefault|0|UINT32|0x00010301
  #
  # TRUE: RK3576AcpiPlatformDxe also hides \_SB.PCIn when UEFI produced no PCI
  # root bridge for segment n (its link did not train, so PciHostBridgeInit.c
  # left the controller in reset).  FALSE keeps the older rule, ComboPHY mode
  # only.  FALSE by default so a board that does not ask for it is unchanged.
  #
  gRK3576TokenSpaceGuid.PcdAcpiPcieRequireRootBridge|FALSE|BOOLEAN|0x00010302
  #
  # ACPI fan control (the board's fan SSDT, OEM table ID "RKFAN"): TRUE in
  # PcdAcpiFanControlSupported makes the setup option visible; the option
  # (PcdAcpiFanControl, default PcdAcpiFanControlDefault) decides whether
  # RK3576AcpiPlatformDxe installs that SSDT.  Without it only the
  # temperature read-out in the DSDT remains.
  #
  gRK3576TokenSpaceGuid.PcdAcpiFanControlSupported|FALSE|BOOLEAN|0x00010303
  gRK3576TokenSpaceGuid.PcdAcpiFanControlDefault|0|UINT8|0x00010304
  #
  # CPU idle states: the setup option (PcdAcpiCpuIdleStates, default
  # PcdAcpiCpuIdleStatesDefault) picks which _LPI SSDT RK3576AcpiPlatformDxe
  # installs: AcpiTables/CpuIdle.asl ("RKLPI", WFI and core power-down) when
  # enabled, AcpiTables/CpuIdleWfi.asl ("RKWFI", WFI only) when disabled.
  #
  gRK3576TokenSpaceGuid.PcdAcpiCpuIdleStatesDefault|0|UINT8|0x00010900
  #
  # "CPU Maximum Frequency" (RK3576Dxe CpuMaxFreq.c).  Supported makes the
  # setup option visible; set it only on a board whose CPU rails the firmware
  # has been shown to reach: an RK806 on I2C bus PcdRk806I2cBus at
  # PcdRk806I2cAddress, vdd_cpu_big_s0 on BUCK1 and vdd_cpu_lit_s0 on BUCK3.
  # The option (PcdCpuMaxFreq, default PcdCpuMaxFreqDefault) is 0 for the
  # PcdCPU{L,B}ClusterClockHz rates and 1 for mainline's top OPPs.
  #
  gRK3576TokenSpaceGuid.PcdCpuMaxFreqSupported|FALSE|BOOLEAN|0x00010901
  gRK3576TokenSpaceGuid.PcdCpuMaxFreqDefault|0|UINT8|0x00010902
  #
  # GPU rail report (RK3576Dxe GpuRail.c): read vdd_gpu_s0 (RK806 BUCK5 on
  # bus PcdRk806I2cBus) and the GPU's OTP bytes, log them with the
  # operating points they allow, and publish the GpuRail variable for the
  # Windows GPU driver.  Reads only; set it on a board whose RK806 the
  # firmware has been seen to reach.
  #
  gRK3576TokenSpaceGuid.PcdGpuRailReport|FALSE|BOOLEAN|0x00010903
  #
  # With PcdGpuRailReport: raise vdd_gpu_s0 from exactly 750 mV (selector
  # 0x28) to 775 mV (0x2C) in 6.25 mV steps, each read back, only on an
  # RK806 reading 0x80 0x6A, a plain RK3576 (OTP specification 0x01) and
  # TSHUT armed.  The 775 mV ceiling is a constant in GpuRail.c.  Approved
  # for the TaishanPi 3M only.
  #
  gRK3576TokenSpaceGuid.PcdGpuRailRaise775|FALSE|BOOLEAN|0x00010904
  # NPU (RKNN) for an ACPI OS: the setup option (PcdAcpiNpu, default
  # PcdAcpiNpuDefault) decides whether RK3576Dxe sets the NPU rail, powers
  # the NPU domains and sets its clock (Npu.c), and whether
  # RK3576AcpiPlatformDxe installs the NPU SSDT (OEM table ID "RKNPU").  The
  # option is shown only on a board that can set the rail, which is one
  # that sets PcdRk806I2cBase.  Off by default.
  #
  gRK3576TokenSpaceGuid.PcdAcpiNpuDefault|0|UINT8|0x00010306
  #
  # Video decoder (RKVDEC, VDPU383) for an ACPI OS: the setup option
  # (PcdAcpiVdec, default PcdAcpiVdecDefault) decides whether RK3576Dxe powers
  # PD_VDEC and sets the decoder clocks, and whether RK3576AcpiPlatformDxe
  # installs the decoder SSDT (OEM table ID "RKVDEC").  Off by default, so a
  # board or OS that does not ask for it sees no change.
  #
  gRK3576TokenSpaceGuid.PcdAcpiVdecDefault|0|UINT8|0x00010305
  #
  # Analog audio preset: the board library sets up the SAI that carries its
  # codec (power domain, mclk, pins) and the DSDT publishes that SAI and the
  # codec for the woa-rk3576 audio drivers.  Only boards that implement it
  # read it (TaishanPi 3M: ES8388 on SAI1 and I2C3).
  #
  gRK3576TokenSpaceGuid.PcdAnalogAudioPreset|FALSE|BOOLEAN|0x00010800
  gRK3576TokenSpaceGuid.PcdFdtCompatModeDefault|0|UINT32|0x00010351
  gRK3576TokenSpaceGuid.PcdFdtForceGopDefault|0|UINT8|0x00010352
  gRK3576TokenSpaceGuid.PcdFdtSupportOverridesDefault|0|UINT8|0x00010353
  gRK3576TokenSpaceGuid.PcdFdtOverrideFixupDefault|0|UINT8|0x00010354
  gRK3576TokenSpaceGuid.PcdFdtOverrideBasePathDefault|L""|VOID*|0x00010355
  gRK3576TokenSpaceGuid.PcdFdtOverrideOverlayPathDefault|L""|VOID*|0x00010356

  # Display
  gRK3576TokenSpaceGuid.PcdDisplayConnectors|{0}|VOID*|0x00010400
  gRK3576TokenSpaceGuid.PcdDisplayForceOutputDefault|0|UINT8|0x00010401
  gRK3576TokenSpaceGuid.PcdDisplayDuplicateOutputDefault|0|UINT8|0x00010402
  #
  # Backlight of a MIPI DSI screen, in percent, while the firmware runs and
  # until an OS changes it: the default of "Screen Brightness" in setup
  # (PcdDisplayBrightness).  Read by the board's panel code, which lights the
  # backlight; a board without a DSI screen ignores it.
  #
  gRK3576TokenSpaceGuid.PcdDisplayBrightnessDefault|60|UINT8|0x00010403

  # Status LED
  gRK3576TokenSpaceGuid.PcdStatusLedGpio|0xFF|UINT8|0x00010500
  gRK3576TokenSpaceGuid.PcdStatusLedGpioPolarity|TRUE|BOOLEAN|0x00010501

  # GMAC — gmac0 (ROCK 4D: RTL8211F RGMII-ID PHY; gmac1 unused on this board)
  gRK3576TokenSpaceGuid.PcdGmac0Supported|FALSE|BOOLEAN|0x00010600
  gRK3576TokenSpaceGuid.PcdGmac0TxDelay|0x00|UINT8|0x00010601
  gRK3576TokenSpaceGuid.PcdGmac0RxDelay|0x00|UINT8|0x00010602
  gRK3576TokenSpaceGuid.PcdGmac1Supported|FALSE|BOOLEAN|0x00010603
  gRK3576TokenSpaceGuid.PcdGmac1TxDelay|0x00|UINT8|0x00010604
  gRK3576TokenSpaceGuid.PcdGmac1RxDelay|0x00|UINT8|0x00010605

  # Cooling fan: duty in percent that RK3576Dxe starts the board's fan at,
  # through PwmFanIoSetup() and PwmFanSetSpeed() in RockchipPlatformLib.  It
  # keeps running after ExitBootServices, so an OS without a fan driver
  # (Windows) still gets cooling.  0 leaves the fan pin and PWM untouched;
  # set it only on a board whose fan wiring is in its platform library.
  gRK3576TokenSpaceGuid.PcdPwmFanSpeedDefault|0|UINT32|0x00010700

  # PWM period of the board fan, in nanoseconds, for PwmFanSetSpeed().  The
  # default 500000 (2 kHz) is what the device trees use.  At 100% duty the
  # pin is held high and the period does not matter.
  gRK3576TokenSpaceGuid.PcdPwmFanPeriodNs|500000|UINT32|0x00010702

  # Rk806I2cPowerOffDxe: the I2C controller and address of an RK806 that
  # the firmware has to switch off itself at a shutdown (see the driver).
  # 0 leaves shutdown to PSCI alone.  RK3576Dxe (Npu.c) sets the NPU rail
  # through the same bus, so 0 also leaves the NPU option unavailable.  The
  # bus must be one I2cDxe sets up (listed in PcdI2cSlaveBuses).
  gRK3576TokenSpaceGuid.PcdRk806I2cBase|0|UINT32|0x00010705
  gRK3576TokenSpaceGuid.PcdRk806I2cAddress|0x23|UINT8|0x00010706
  # The I2C bus number (I2cDxe's, as in PcdI2cSlaveBuses) of the same RK806,
  # for RK3576Dxe's CpuMaxFreq.c, which goes through I2cDxe's protocol.
  gRK3576TokenSpaceGuid.PcdRk806I2cBus|1|UINT8|0x00010707

  # TRUE: RK3576Dxe starts the TSADC sampling at boot and arms the hardware
  # thermal shutdown (PcdTsadcTshutEnable below; no interrupt, no reset
  # write, see Rk3576TsadcLib.c), and RK3576AcpiPlatformDxe tells the DSDT's
  # thermal zones, if the DSDT includes Thermal.asl, that they may read it.
  # FALSE leaves the TSADC untouched.
  gRK3576TokenSpaceGuid.PcdTsadcEnable|FALSE|BOOLEAN|0x00010701

  # Hardware thermal shutdown (TSHUT), only when PcdTsadcEnable is TRUE:
  # TRUE arms the TSADC's output to the CRU, a full chip reset, at
  # PcdTsadcTshutTemp millidegrees C plus each channel's OTP trim, the way
  # mainline Linux does with rk3576.dtsi (rockchip,hw-tshut-temp = <120000>,
  # rockchip,hw-tshut-mode = <0>, CRU).  It protects an OS without a TSADC
  # driver (Windows).  The PMIC (GPIO) mode is not implemented.
  gRK3576TokenSpaceGuid.PcdTsadcTshutEnable|TRUE|BOOLEAN|0x00010710
  gRK3576TokenSpaceGuid.PcdTsadcTshutTemp|120000|UINT32|0x00010711

  # How long, in ms, the firmware waits at boot for a device to appear on
  # the USB-C port (DRD0), so that a bus-powered disk that drops off and
  # reconnects once during its own start-up still gets a boot option.  The
  # wait runs to the end when nothing is plugged in.  0 on a board whose
  # firmware does not power the port: nothing can appear there.
  gRK3576TokenSpaceGuid.PcdUsbCDeviceWaitMs|5000|UINT32|0x00010703

  # TRUE: mark the USB-A VBUS regulators of the device tree handed to the
  # OS always-on, also in a tree loaded from the boot partition.  For a
  # board whose mainline tree names them only in usb-a-connector nodes,
  # which nothing enables, so Linux switches the ports off when it
  # registers the regulators and loses a USB stick it is booting from.
  gRK3576TokenSpaceGuid.PcdFdtUsbAVbusAlwaysOn|FALSE|BOOLEAN|0x00010704

[PcdsFixedAtBuild, PcdsPatchableInModule, PcdsDynamic, PcdsDynamicEx]
  # Runtime dynamic PCDs (set by RK3576Dxe at DXE phase from *Default FixedAtBuild values)
  gRK3576TokenSpaceGuid.PcdComboPhy0Mode|0|UINT32|0x00000101
  gRK3576TokenSpaceGuid.PcdComboPhy1Mode|0|UINT32|0x00000102

  gRK3576TokenSpaceGuid.PcdConfigTableMode|0|UINT32|0x00000300
  gRK3576TokenSpaceGuid.PcdFdtCompatMode|0|UINT32|0x00000351
  gRK3576TokenSpaceGuid.PcdAcpiFanControl|0|UINT8|0x00000303
  gRK3576TokenSpaceGuid.PcdAcpiCpuIdleStates|0|UINT8|0x00000900
  gRK3576TokenSpaceGuid.PcdCpuMaxFreq|0|UINT8|0x00000901
  gRK3576TokenSpaceGuid.PcdAcpiNpu|0|UINT8|0x00000305
  gRK3576TokenSpaceGuid.PcdAcpiVdec|0|UINT8|0x00000304
  gRK3576TokenSpaceGuid.PcdDisplayBrightness|60|UINT8|0x00000400
  gRK3576TokenSpaceGuid.PcdFdtForceGop|0|UINT8|0x00000352
  gRK3576TokenSpaceGuid.PcdFdtSupportOverrides|0|UINT8|0x00000353
  gRK3576TokenSpaceGuid.PcdFdtOverrideFixup|0|UINT8|0x00000354
  gRK3576TokenSpaceGuid.PcdFdtOverrideBasePath|{ 0x0 }|FDT_OVERRIDE_PATH_VARSTORE_DATA|0x00000355 {
    <Packages>
      Silicon/Rockchip/RK3576/RK3576.dec
    <HeaderFiles>
      Include/VarStoreData.h
  }
  gRK3576TokenSpaceGuid.PcdFdtOverrideOverlayPath|{ 0x0 }|FDT_OVERRIDE_PATH_VARSTORE_DATA|0x00000356 {
    <Packages>
      Silicon/Rockchip/RK3576/RK3576.dec
    <HeaderFiles>
      Include/VarStoreData.h
  }

  # PCIe ECAM compliant segments bitmask (set at runtime by PciHostBridgeInit)
  gRK3576TokenSpaceGuid.PcdPcieEcamCompliantSegmentsMask|0|UINT32|0x00000600

  # ACPI PCIe ECAM compatibility mode (0 = AUTO, see VarStoreData.h)
  gRK3576TokenSpaceGuid.PcdAcpiPcieEcamCompatMode|0|UINT32|0x00000601
