[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ArmbianOnceLib
  FILE_GUID                      = a981c4f2-5a09-4222-b818-8b4178e9887b
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ArmbianOnceLib|DXE_DRIVER UEFI_APPLICATION

[Sources]
  ArmbianOnceLib.c

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  Silicon/Rockchip/RockchipPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  FdtLib
  MemoryAllocationLib
  UefiBootServicesTableLib

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiDiskIoProtocolGuid
  gEdkiiNonDiscoverableDeviceProtocolGuid
  gEfiPartitionInfoProtocolGuid

[FixedPcd]
  gRockchipTokenSpaceGuid.PcdDwcSdhciBaseAddress
  gRockchipTokenSpaceGuid.PcdRkSdmmcBaseAddress
