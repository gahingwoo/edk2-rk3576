# Merged over rock-4d-rk3576_defconfig by scripts/build-spl.sh.
# The defconfig and the device tree files next to this are U-Boot
# v2026.10's own (configs/, dts/upstream/, arch/arm/dts/), unchanged.  The
# boot order stays "same-as-spl" (the SPI NOR) first, then the SD card.
CONFIG_LOCALVERSION="-edk2-rk3576"
# CONFIG_LOCALVERSION_AUTO is not set
# Must stay off: the FIT's EDK2 image is stored uncompressed.
# CONFIG_SPL_GZIP is not set
# v1.12 boards carry an XMC XM25QU128C, earlier ones a Macronix part
# (binaries/README.md, idblock_mainline.bin).
CONFIG_SPI_FLASH_XMC=y
CONFIG_SPL_MMC_WRITE=y
CONFIG_SPL_ROCKCHIP_ARMBIAN_ONCE=y
CONFIG_SPL_ROCKCHIP_ARMBIAN_ONCE_SD_REQUEST=y
