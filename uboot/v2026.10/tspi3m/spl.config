# Merged over lckfb-tspi-3m-rk3576_defconfig by scripts/build-spl.sh.
# The defconfig and the device tree files next to this are Armbian's
# (patch/u-boot/v2026.10 in armbian/build), except that the -u-boot.dtsi
# here makes the SPL try the SD card first.
CONFIG_LOCALVERSION="-edk2-rk3576"
# CONFIG_LOCALVERSION_AUTO is not set
# Must stay off: the FIT's EDK2 image is stored uncompressed.
# CONFIG_SPL_GZIP is not set
CONFIG_SPL_MMC_WRITE=y
CONFIG_SPL_ROCKCHIP_ARMBIAN_ONCE=y
