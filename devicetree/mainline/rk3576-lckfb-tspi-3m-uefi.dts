		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi_in {
	dsi_in_vp2: endpoint {
		remote-endpoint = <&vp2_out_dsi>;
	};
};

&dsi_out {
	dsi_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi>;
	};
};

&vp2 {
	#address-cells = <1>;
	#size-cells = <0>;

	vp2_out_dsi: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi_in_vp2>;
	};
};

&pinctrl {
	lcd {
		lcd_rst: lcd-rst {
			rockchip,pins = <2 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * PWM2 channels 2 (backlight) and 3 (fan), as the RK3576 PWM v5 series
 * describes them (Armbian's rk3576-pwm-v5 patch, "arm64: dts: rockchip: add
 * PWM nodes to RK3576 SoC dtsi"), with this board's pins.  Same node names
 * and addresses, so a mainline rk3576.dtsi that gains them merges with
 * these.  Channel 2 is enabled with the backlight.
 */
&{/soc} {
	pwm2_8ch_2: pwm@2ade2000 {
		compatible = "rockchip,rk3576-pwm";
		reg = <0x0 0x2ade2000 0x0 0x1000>;
		clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>,
			 <&cru CLK_OSC_PWM2>, <&cru CLK_RC_PWM2>;
		clock-names = "pwm", "pclk", "osc", "rc";
		interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwm2m3_ch2>;
		#pwm-cells = <3>;
		status = "disabled";
	};

	/*
	 * The fan, which the firmware leaves running (PwmFanSetSpeed).  No
	 * pwm-fan: Armbian's runs it at 2 kHz, which TaishanPi3M.dsc records
	 * as audible on this fan at partial duty, and the firmware's 25 kHz
	 * has not been run through Linux's thermal control.  The PWM driver
	 * finds the channel running at probe and keeps it so.
	 */
	pwm2_8ch_3: pwm@2ade3000 {
		compatible = "rockchip,rk3576-pwm";
		reg = <0x0 0x2ade3000 0x0 0x1000>;
		clocks = <&cru CLK_PWM2>, <&cru PCLK_PWM2>,
			 <&cru CLK_OSC_PWM2>, <&cru CLK_RC_PWM2>;
		clock-names = "pwm", "pclk", "osc", "rc";
		interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pwm2m3_ch3>;
		#pwm-cells = <3>;
		status = "okay";
	};
};

/*
 * The GPU is described but left disabled.  With it enabled, Armbian edge
 * 7.3.4 booted through this firmware probed panfrost and then took an
 * SError in panfrost_job_timedout, twice, 37 s and 281 s after boot: a GPU
 * job hung, and the reset path read GPU registers that no longer answered.
 * The cause is not known.  One difference from a U-Boot boot of the same
 * kernel is the BL31: Armbian's U-Boot uses Rockchip's v1.20, this firmware
 * the open-source TF-A v2.14, whose SCMI_CLK_GPU moves the GPU onto its
 * PVTPLL above 200 MHz.  Until the cause is known, a GPU that can bring the
 * system down is worse than none.  Everything else a working GPU needs is here, so
 * enabling it is this one status.
 */
&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "disabled";
};

/*
 * The GPU power domain's supply.  A kernel with Leonard Lausen's
 * "pmdomain: rockchip: Manage the RK3576 GPU domain supply" (Armbian 7.4)
 * turns vdd_gpu_s0 on before it powers the domain; without it, the domain
 * failed to power up on the NanoPi M5.  Older kernels ignore the property.
 * The node has no label in rk3576.dtsi.
 */
&{/soc/power-management@27380000/power-controller/power-domain@4} {
	domain-supply = <&vdd_gpu_s0>;
};

/*
 * Mini-PCIe slot reset (PERST#).  Nothing drives it otherwise, and an EC20
 * 4G module stays in reset until it is released.
 */
&gpio2 {
	minipcie-reset-hog {
		gpio-hog;
		gpios = <RK_PB1 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "minipcie-reset";
	};
};

/* The mini-PCIe slot (EC20 4G module) has no driver to claim its supply. */
&vcc_3v3_minipcie {
	regulator-always-on;
};

/*
 * The GPU's clocks as Armbian's kernel (7.3 and 7.4) wants them: panfrost
 * there sets the OPP rate on a clock named "gpu", and the 7.4-rc SoC dtsi's
 * single "core" clock made it fail to probe ("Couldn't find clock with
 * name: gpu").  Jonas Karlman's series, which Armbian carries
 * (rk35xx-panthor-1GHz.patch): SCMI_CLK_GPU is the GPU clock, because TF-A
 * switches it between a normal PLL and the GPU PVTPLL by rate, and CLK_GPU
 * becomes the bus clock, as on the RK3568.  A mainline panfrost takes the
 * first clock as its clock and "bus" as the optional bus clock, so it reads
 * this the same way.
 */
&gpu {
	assigned-clocks = <&cru CLK_GPU>, <&scmi_clk SCMI_CLK_GPU>;
	assigned-clock-rates = <198000000>, <200000000>;
	clocks = <&scmi_clk SCMI_CLK_GPU>, <&cru CLK_GPU>;
	clock-names = "gpu", "bus";
};

/*
 * The same series' OPP table: the datasheet's 900 MHz maximum and the
 * vendor kernel's voltages, and a 200 MHz point for the rate the GPU starts
 * at.  Without the series' opp-suspend: on a kernel without its panfrost
 * change, a suspend frequency is set on the SCMI clock while the GPU is
 * already suspended, which the series reports as an SError.
 */
&gpu_opp_table {
	/delete-node/ opp-950000000;

	opp-200000000 {
		opp-hz = /bits/ 64 <200000000>;
		opp-microvolt = <712500 712500 875000>;
	};

	opp-300000000 {
		opp-microvolt = <712500 712500 875000>;
	};

	opp-400000000 {
		opp-microvolt = <712500 712500 875000>;
	};

	opp-500000000 {
		opp-microvolt = <712500 712500 875000>;
	};

	opp-600000000 {
		opp-microvolt = <712500 712500 875000>;
	};

	opp-700000000 {
		opp-microvolt = <750000 750000 875000>;
	};

	opp-800000000 {
		opp-microvolt = <812500 812500 875000>;
	};

	opp-900000000 {
		opp-microvolt = <875000 875000 875000>;
	};
};
