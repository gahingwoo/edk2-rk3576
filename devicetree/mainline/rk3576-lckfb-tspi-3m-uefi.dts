/*
 * LCKFB TaishanPi 3M -- the device tree the UEFI firmware hands to the OS.
 *
 * rk3576-lckfb-tspi-3m.dts next to this file is the mainline Linux 7.3 file,
 * unchanged.  Anything the firmware needs on top of it goes here, so the
 * mainline file can be replaced by a newer one without a merge.
 *
 * Added: the GT9271 touch controller of LCKFB's 800x1280 DSI screen.  The
 * screen itself is not described: mainline has no init sequence for this
 * panel, so an OS either keeps the picture the firmware left (the "force
 * GOP" setting) or brings its own device tree.  Touch needs nothing but
 * the mainline goodix driver, and a missing screen only fails its probe.
 *
 * Added: the ES8388 headphone codec on I2C3 and SAI1, as a simple-audio-card
 * with jack detection (GPIO4 PB0) and the headphone amplifier enable (GPIO4
 * PB2).  Taken unchanged from Armbian's board patch
 * (rockchip64-7.3/board-lckfb-tspi-3m-01-onboard-hardware.patch), whose
 * device tree gave audible headphone output on this board with Linux 7.3.4
 * booted through this firmware.  Mainline describes only HDMI audio.  None
 * of it is in the ACPI tables' way: Windows gets the codec from the DSDT.
 *
 * Added: both USB-A VBUS supplies stay on.  The usb-a-connector nodes name
 * them, but no driver enables a connector's supply behind a hub, so the
 * kernel switched them off when it registered the regulators: a system
 * started from a USB stick lost the stick before it could mount it.
 *
 * The CM5-IO wrapper forces both USB controllers to
 * host mode and enables the UFS controller; neither has been shown to be
 * needed on this board, and the USB-C port here is described with a FUSB302
 * and role switching that a forced host mode would override.
 *
 * Copyright (c) 2026, Jiaxing Hu <gahing@gahingwoo.com>
 */

#include "rk3576-lckfb-tspi-3m.dts"

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m1_xfer>;
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt9271";
		reg = <0x5d>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		/*
		 * The line resets the chip when low, but the goodix driver
		 * writes 0 to reset and 1 to release, so this is ACTIVE_HIGH
		 * like on every other board using it.
		 */
		reset-gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_int &touch_rst>;
	};
};

&pinctrl {
	touch {
		/* The interrupt line needs a pull-up and the board has none. */
		touch_int: touch-int {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		touch_rst: touch-rst {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&vcc_5v0_usb2_host {
	regulator-always-on;
	regulator-boot-on;
};

&vcc_5v0_usb3_host {
	regulator-always-on;
	regulator-boot-on;
};

/ {
	hp_amp: headphone-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio4 RK_PB2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_ctl>;
		sound-name-prefix = "Headphone Amp";
	};

	es8388_sound: es8388-sound {
		compatible = "simple-audio-card";
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;
		simple-audio-card,name = "rockchip-es8388";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,aux-devs = <&hp_amp>;
		simple-audio-card,hp-det-gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
		simple-audio-card,routing =
			"Headphones", "Headphone Amp OUTL",
			"Headphones", "Headphone Amp OUTR",
			"Headphone Amp INL", "LOUT1",
			"Headphone Amp INR", "ROUT1",
			"LINPUT1", "Onboard Microphone",
			"LINPUT2", "Onboard Microphone",
			"RINPUT1", "Headset Microphone",
			"RINPUT2", "Headset Microphone";
		simple-audio-card,widgets =
			"Headphone", "Headphones",
			"Microphone", "Onboard Microphone",
			"Microphone", "Headset Microphone";

		simple-audio-card,codec {
			sound-dai = <&es8388>;
			system-clock-frequency = <12288000>;
		};

		simple-audio-card,cpu {
			sound-dai = <&sai1>;
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;
	status = "okay";

	es8388: audio-codec@11 {
		compatible = "everest,es8388", "everest,es8328";
		reg = <0x11>;
		#sound-dai-cells = <0>;
		clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
		assigned-clocks = <&cru CLK_SAI1_MCLKOUT_TO_IO>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sai1m0_mclk>;
		AVDD-supply = <&vcca_3v3_s0>;
		DVDD-supply = <&vcc_3v3_s0>;
		HPVDD-supply = <&vcca_3v3_s0>;
		PVDD-supply = <&vcc_3v3_s0>;
	};
};

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		hp_ctl: hp-ctl {
			rockchip,pins = <4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/*
 * Only SDO2 reaches the codec's DAC input.  The route puts the first data
 * lane (the stereo pair a 2-channel stream uses) on SDO2.
 */
&sai1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sai1m0_lrck
		     &sai1m0_sclk
		     &sai1m0_sdi0
		     &sai1m0_sdo2>;
	rockchip,sai-tx-route = <2 1 0 3>;
	status = "okay";
};
