+//
+// A middle click: select the statement it lands on at once.  The click
+// itself comes as any other click (PointerClick.c) and moves the
+// highlight; the pointer driver then answers TRUE, once, when asked
+// whether that click was one to act on, and the statement is selected
+// as Enter would.  With no such driver the answer is always FALSE.
+// The pointer driver has a copy of this definition.
+//
+#define DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL_GUID \
+  { 0x0cce83d2, 0x5f6e, 0x4079, { 0xba, 0xc7, 0x03, 0x16, 0x94, 0x61, 0x51, 0xf0 } }
+
+typedef struct _DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL;
+
+typedef
+BOOLEAN
+(EFIAPI *DISPLAY_POINTER_TAKE_ACTIVATE)(
+  IN DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL  *This
+  );
+
+struct _DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL {
+  UINT32                           Revision;
+  DISPLAY_POINTER_TAKE_ACTIVATE    TakeActivate;
+};
+
+STATIC EFI_GUID  mUiClickActivateGuid = DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL_GUID;
+
+/**
+  Whether the last click was one to act on at once; asking clears it.
+**/
+STATIC
+BOOLEAN
+UiClickActivates (
+  VOID
+  )
+{
+  DISPLAY_POINTER_CLICK_ACTIVATE_PROTOCOL  *Activate;
+
+  if (EFI_ERROR (gBS->LocateProtocol (&mUiClickActivateGuid, NULL, (VOID **)&Activate))) {
+    return FALSE;
+  }
+
+  return Activate->TakeActivate (Activate);
+}
+
