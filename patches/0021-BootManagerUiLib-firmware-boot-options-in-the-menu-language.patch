+  PathLabel = HiiGetString (HiiHandle, STRING_TOKEN (STR_BM_DEVICE_PATH), NULL);
+  if (PathLabel == NULL) {
+    PathLabel = AllocateCopyPool (sizeof (L"Device Path : "), L"Device Path : ");
+    ASSERT (PathLabel != NULL);
+  }
+
+  //
   // Allocate space for creation of UpdateData Buffer
   //
   StartOpCodeHandle = HiiAllocateOpCodeHandle ();
@@ -613,14 +681,14 @@
 
     ASSERT (BootOption[Index].Description != NULL);
 
-    Token = HiiSetString (HiiHandle, 0, BootOption[Index].Description, NULL);
+    Token = BmBootOptionToken (HiiHandle, &BootOption[Index]);
 
     TempStr    = BmDevicePathToStr (BootOption[Index].FilePath);
     TempSize   = StrSize (TempStr);
-    HelpString = AllocateZeroPool (TempSize + StrSize (L"Device Path : "));
-    MaxLen     = (TempSize + StrSize (L"Device Path : "))/sizeof (CHAR16);
+    HelpString = AllocateZeroPool (TempSize + StrSize (PathLabel));
+    MaxLen     = (TempSize + StrSize (PathLabel))/sizeof (CHAR16);
     ASSERT (HelpString != NULL);
-    StrCatS (HelpString, MaxLen, L"Device Path : ");
+    StrCatS (HelpString, MaxLen, PathLabel);
     StrCatS (HelpString, MaxLen, TempStr);
 
     HelpToken = HiiSetString (HiiHandle, 0, HelpString, NULL);
@@ -651,6 +719,7 @@
   HiiFreeOpCodeHandle (EndOpCodeHandle);
 
   EfiBootManagerFreeLoadOptions (BootOption, BootOptionCount);
