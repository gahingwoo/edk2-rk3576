diff --git a/MdeModulePkg/Library/BootManagerUiLib/BootManager.c b/MdeModulePkg/Library/BootManagerUiLib/BootManager.c
--- a/MdeModulePkg/Library/BootManagerUiLib/BootManager.c
+++ b/MdeModulePkg/Library/BootManagerUiLib/BootManager.c
@@ -466,6 +466,64 @@
   return ToText;
 }
 
+//
+// patches/0021: the platform registers some of its firmware applications as
+// boot options with a fixed English description.  A Boot#### variable holds
+// one description for every language, so the menu shows these few in the
+// menu language instead.  Only an option whose file path ends in a firmware
+// volume file (FvFile) and whose description matches exactly is shown this
+// way; the variable is not changed.
+//
+typedef struct {
+  CONST CHAR16     *Description;
+  EFI_STRING_ID    Token;
+} BM_FV_OPTION_NAME;
+
+STATIC CONST BM_FV_OPTION_NAME  mBmFvOptionNames[] = {
+  { L"Reset to MaskROM",   STRING_TOKEN (STR_BM_RESET_TO_MASKROM)   },
+  { L"Reset All Settings", STRING_TOKEN (STR_BM_RESET_ALL_SETTINGS) },
+};
+
+/**
+  The string to show for a boot option in the menu.
+
+  @param HiiHandle  The Boot Manager's HII handle.
+  @param Option     The boot option.
+
+  @return  A string of the Boot Manager's package: a translated one for the
+           firmware applications in mBmFvOptionNames, else a new string
+           holding the option's description.
+**/
+STATIC
+EFI_STRING_ID
+BmBootOptionToken (
+  IN EFI_HII_HANDLE                HiiHandle,
+  IN EFI_BOOT_MANAGER_LOAD_OPTION  *Option
+  )
+{
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+  EFI_DEVICE_PATH_PROTOCOL  *Last;
+  UINTN                     Index;
+
+  Last = NULL;
+  for (Node = Option->FilePath; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+    Last = Node;
+  }
+
+  if ((Last != NULL) &&
+      (DevicePathType (Last) == MEDIA_DEVICE_PATH) &&
+      (DevicePathSubType (Last) == MEDIA_PIWG_FW_FILE_DP))
+  {
+    for (Index = 0; Index < ARRAY_SIZE (mBmFvOptionNames); Index++) {
+      if (StrCmp (Option->Description, mBmFvOptionNames[Index].Description) == 0) {
+        return mBmFvOptionNames[Index].Token;
+      }
+    }
+  }
+
+  return HiiSetString (HiiHandle, 0, Option->Description, NULL);
+}
+
 /**
   This function invokes Boot Manager. It then enumerate all boot options. If
   a boot option from the Boot Manager page is selected, Boot Manager will boot
@@ -497,6 +555,7 @@
