+/**
+  The device path of the FullReset application in the firmware volume this
+  application was loaded from, or NULL if it is not there.  (patches/0014)
+**/
+STATIC
+EFI_DEVICE_PATH_PROTOCOL *
+UiFullResetAppDevicePath (
+  VOID
+  )
+{
+  EFI_STATUS                         Status;
+  EFI_LOADED_IMAGE_PROTOCOL          *LoadedImage;
+  EFI_FIRMWARE_VOLUME2_PROTOCOL      *Fv;
+  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  FileNode;
+  UINTN                              Size;
+  EFI_FV_FILETYPE                    Type;
+  EFI_FV_FILE_ATTRIBUTES             Attributes;
+  UINT32                             AuthenticationStatus;
+
+  Status = gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&LoadedImage);
+  if (EFI_ERROR (Status)) {
+    return NULL;
+  }
+
+  Status = gBS->HandleProtocol (LoadedImage->DeviceHandle, &gEfiFirmwareVolume2ProtocolGuid, (VOID **)&Fv);
+  if (EFI_ERROR (Status)) {
+    return NULL;
+  }
+
+  Status = Fv->ReadFile (Fv, &mFullResetAppFileGuid, NULL, &Size, &Type, &Attributes, &AuthenticationStatus);
+  if (EFI_ERROR (Status)) {
+    return NULL;
+  }
+
+  EfiInitializeFwVolDevicepathNode (&FileNode, &mFullResetAppFileGuid);
+  return AppendDevicePathNode (DevicePathFromHandle (LoadedImage->DeviceHandle), (EFI_DEVICE_PATH_PROTOCOL *)&FileNode);
+}
+
+/**
+  Start the FullReset application.  (patches/0014)
+**/
+STATIC
+VOID
+UiStartFullResetApp (
+  VOID
+  )
+{
+  EFI_STATUS                Status;
+  EFI_DEVICE_PATH_PROTOCOL  *DevicePath;
+  EFI_HANDLE                ImageHandle;
+
+  DevicePath = UiFullResetAppDevicePath ();
+  if (DevicePath == NULL) {
+    return;
+  }
+
+  Status = gBS->LoadImage (FALSE, gImageHandle, DevicePath, NULL, 0, &ImageHandle);
+  FreePool (DevicePath);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: cannot load FullReset: %r\n", __func__, Status));
+    return;
+  }
+
+  gBS->StartImage (ImageHandle, NULL, NULL);
+}
