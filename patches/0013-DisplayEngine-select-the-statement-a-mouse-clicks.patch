diff --git a/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.c b/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.c
new file mode 100644
index 0000000000..cf365f120c
--- /dev/null
+++ b/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.c
@@ -0,0 +1,85 @@
+/** @file
+  Clicks from a pointer, as text cells, for the menus.  See PointerClick.h.
+
+  Copyright (c) 2026, Jiaxing Hu <gahing@gahingwoo.com>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#include "FormDisplay.h"
+
+STATIC EFI_GUID                        mPointerClickGuid = DISPLAY_POINTER_CLICK_PROTOCOL_GUID;
+STATIC DISPLAY_POINTER_CLICK_PROTOCOL  *mPointerClick;
+
+EFI_EVENT
+PointerClickBegin (
+  VOID
+  )
+{
+  //
+  // Looked for every time: a pointer driver may come after this one, and
+  // the lookup is cheap next to waiting for a person.
+  //
+  if (EFI_ERROR (gBS->LocateProtocol (&mPointerClickGuid, NULL, (VOID **)&mPointerClick)) ||
+      (mPointerClick->Revision < DISPLAY_POINTER_CLICK_REVISION) ||
+      (mPointerClick->WaitForClick == NULL))
+  {
+    mPointerClick = NULL;
+    return NULL;
+  }
+
+  mPointerClick->SetReading (mPointerClick, TRUE);
+  return mPointerClick->WaitForClick;
+}
+
+VOID
+PointerClickEnd (
+  VOID
+  )
+{
+  if (mPointerClick != NULL) {
+    mPointerClick->SetReading (mPointerClick, FALSE);
+  }
+}
+
+BOOLEAN
+PointerClickGet (
+  OUT UINTN  *Column,
+  OUT UINTN  *Row
+  )
+{
+  return (mPointerClick != NULL) &&
+         !EFI_ERROR (mPointerClick->GetClick (mPointerClick, Column, Row));
+}
+
+BOOLEAN
+WaitForKeyOrClick (
+  OUT EFI_INPUT_KEY  *Key,
+  OUT UINTN          *Column,
+  OUT UINTN          *Row
+  )
+{
+  EFI_EVENT   WaitList[2];
+  EFI_STATUS  Status;
+  UINTN       Index;
+
+  while (TRUE) {
+    if (!EFI_ERROR (gST->ConIn->ReadKeyStroke (gST->ConIn, Key))) {
+      return FALSE;
+    }
+
+    WaitList[1] = PointerClickBegin ();
+    if (WaitList[1] == NULL) {
+      WaitForKeyStroke (Key);
+      return FALSE;
+    }
+
+    WaitList[0] = gST->ConIn->WaitForKey;
+    Status      = gBS->WaitForEvent (2, WaitList, &Index);
+    PointerClickEnd ();
+
+    if (!EFI_ERROR (Status) && (Index == 1) && PointerClickGet (Column, Row)) {
+      return TRUE;
+    }
+  }
+}
diff --git a/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.h b/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.h
new file mode 100644
index 0000000000..c7bdbc3222
--- /dev/null
+++ b/MdeModulePkg/Universal/DisplayEngineDxe/PointerClick.h
@@ -0,0 +1,99 @@
+/** @file
+  Clicks from a pointer, as text cells, for the menus.
+
+  A platform driver that draws a mouse pointer may install the protocol
+  below.  While the display engine waits for input it says so with
+  SetReading (TRUE); a click then comes as the text cell it landed on,
+  through WaitForClick and GetClick, instead of as a key.  With no such
+  protocol nothing here does anything and the menus read keys only, as
+  before.
+
+  The layout is shared with the platform driver (on Rockchip boards,
+  OnScreenKeyboardDxe); the GUID and the structure must not change on one
+  side only.
+
+  Copyright (c) 2026, Jiaxing Hu <gahing@gahingwoo.com>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+
+**/
+
+#ifndef POINTER_CLICK_H_
+#define POINTER_CLICK_H_
+
+#define DISPLAY_POINTER_CLICK_PROTOCOL_GUID \
+  { 0x5b0d2c6e, 0x8e41, 0x4b7a, { 0x9f, 0x13, 0x2a, 0x6c, 0x70, 0x4e, 0xd1, 0x95 } }
+
+#define DISPLAY_POINTER_CLICK_REVISION  1
+
+typedef struct _DISPLAY_POINTER_CLICK_PROTOCOL DISPLAY_POINTER_CLICK_PROTOCOL;
+
+/**
+  The click that is waiting, as a text cell of the console (column, row).
+
+  @retval EFI_SUCCESS    A click, now taken.
+  @retval EFI_NOT_READY  None.
+**/
+typedef
+EFI_STATUS
+(EFIAPI *DISPLAY_POINTER_GET_CLICK)(
+  IN  DISPLAY_POINTER_CLICK_PROTOCOL  *This,
+  OUT UINTN                           *Column,
+  OUT UINTN                           *Row
+  );
+
+/**
+  TRUE while the caller waits for input and takes clicks; FALSE when it
+  stops.  Clicks outside that time are the platform's (it may send them
+  as Enter, for instance).
+**/
+typedef
+VOID
+(EFIAPI *DISPLAY_POINTER_SET_READING)(
+  IN DISPLAY_POINTER_CLICK_PROTOCOL  *This,
+  IN BOOLEAN                         Reading
+  );
+
+struct _DISPLAY_POINTER_CLICK_PROTOCOL {
+  UINT32                         Revision;
+  EFI_EVENT                      WaitForClick;
+  DISPLAY_POINTER_GET_CLICK      GetClick;
+  DISPLAY_POINTER_SET_READING    SetReading;
+};
+
+/**
+  Start taking clicks: the event to wait on, or NULL when there is no
+  pointer.  Every call is paired with PointerClickEnd ().
+**/
+EFI_EVENT
+PointerClickBegin (
+  VOID
+  );
+
+VOID
+PointerClickEnd (
+  VOID
+  );
+
+/**
+  The click that woke the wait, if there is one.
+**/
+BOOLEAN
+PointerClickGet (
+  OUT UINTN  *Column,
+  OUT UINTN  *Row
+  );
+
+/**
+  WaitForKeyStroke (), and a click as well when there is a pointer.
+
+  @retval FALSE  Key holds a key.
+  @retval TRUE   A click, at Column, Row; Key is not set.
+**/
+BOOLEAN
+WaitForKeyOrClick (
+  OUT EFI_INPUT_KEY  *Key,
+  OUT UINTN          *Column,
+  OUT UINTN          *Row
+  );
+
+#endif
