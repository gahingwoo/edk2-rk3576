+    Left += gModalSkipColumn;
+  }
+
+  Right = Left + LEFT_SKIPPED_COLUMNS + gPromptBlockWidth + gOptionBlockWidth;
+  if ((TopOfScreen == NULL) || (Column < Left) || (Column >= Right) || (Row < TopRow) || (Row > BottomRow)) {
+    return NULL;
+  }
+
+  Current = TopRow;
+  for (Link = TopOfScreen; Link != &gMenuOption; Link = Link->ForwardLink) {
+    MenuOption = MENU_OPTION_FROM_LINK (Link);
+    Lines      = MenuOption->Skip;
+    if (Link == TopOfScreen) {
+      Lines = (Lines > SkipValue) ? Lines - SkipValue : 0;
+    }
+
+    if ((Row >= Current) && (Row < Current + Lines)) {
+      return MenuOption;
+    }
+
+    Current += Lines;
+    if (Current > BottomRow) {
+      break;
+    }
+  }
+
+  return NULL;
+}
