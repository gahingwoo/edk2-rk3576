+/**
+  The statement shown at a text cell, found the way the repaint lays the
+  statements out: from TopOfScreen down, each taking its Skip rows (the
+  first less SkipValue), in the prompt and option columns.  NULL for
+  anything else: blank rows, the help text, the title, the key bar.
+**/
+STATIC
+UI_MENU_OPTION *
+UiMenuOptionAt (
+  IN LIST_ENTRY  *TopOfScreen,
+  IN UINTN       SkipValue,
+  IN UINTN       TopRow,
+  IN UINTN       BottomRow,
+  IN UINTN       Column,
+  IN UINTN       Row
+  )
+{
+  LIST_ENTRY      *Link;
+  UI_MENU_OPTION  *MenuOption;
+  UINTN           Left;
+  UINTN           Right;
+  UINTN           Current;
