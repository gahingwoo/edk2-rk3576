+//
+// What the strings were loaded for.  They are first loaded by the library
+// constructor, which can run before the variable services and before a touch
+// screen driver has started, and RefreshLibStrings() reloads them when either
+// answer has changed, so the key help follows a language switch.
+//
+STATIC CHAR8    mLibStringsLanguage[16];
+STATIC BOOLEAN  mLibStringsTouch;
+
+/**
+  Is there a touch screen that types keys?  It is a device that is both a
+  text input and an absolute pointer; the console splitter's own handle has
+  both too and is left out.
+
+  @retval TRUE   Such a device is present.
+  @retval FALSE  It is not.
+
+**/
+STATIC
+BOOLEAN
+LibHasTouchKeys (
+  VOID
+  )
+{
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+  VOID        *Interface;
+  BOOLEAN     Present;
+
+  if (EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &gEfiAbsolutePointerProtocolGuid, NULL, &Count, &Handles))) {
+    return FALSE;
+  }
+
+  Present = FALSE;
+  for (Index = 0; Index < Count; Index++) {
+    if ((Handles[Index] != gST->ConsoleInHandle) &&
+        !EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleTextInProtocolGuid, &Interface)))
+    {
+      Present = TRUE;
+      break;
+    }
+  }
+
+  FreePool (Handles);
+  return Present;
+}
+
