+//
+// The language the strings above were loaded in.  They are first loaded at
+// driver entry, which can be before the variable services are up, so in no
+// particular language; RefreshDisplayStrings() reloads them when the
+// platform language differs, so the pop-ups follow a language switch.
+//
+STATIC CHAR8  mDisplayStringsLanguage[16];
+
+/**
+  Register one of the default hot keys, replacing the help text it had.
+
+  @param  FormBrowserEx2   The browser extension protocol.
+  @param  ScanCode         SCAN_F9 or SCAN_F10.
+  @param  Action           What the key does.
+  @param  DefaultId        The default store for BROWSER_ACTION_DEFAULT.
+  @param  HelpToken        The help string.
+
+**/
+STATIC
+VOID
+ReRegisterHotKey (
+  IN EDKII_FORM_BROWSER_EXTENSION2_PROTOCOL  *FormBrowserEx2,
+  IN UINT16                                  ScanCode,
+  IN UINT32                                  Action,
+  IN UINT16                                  DefaultId,
+  IN EFI_STRING_ID                           HelpToken
+  )
+{
+  EFI_INPUT_KEY  HotKey;
+  EFI_STRING     NewString;
+
+  NewString = HiiGetString (gHiiHandle, HelpToken, NULL);
+  if (NewString == NULL) {
+    return;
+  }
+
+  HotKey.UnicodeChar = CHAR_NULL;
+  HotKey.ScanCode    = ScanCode;
+  FormBrowserEx2->RegisterHotKey (&HotKey, BROWSER_ACTION_UNREGISTER, 0, NULL);
+  FormBrowserEx2->RegisterHotKey (&HotKey, Action, DefaultId, NewString);
+  FreePool (NewString);
+}
+
+/**
+  Reload the display strings, and the F9 / F10 help text, if the platform
+  language has changed since they were loaded.
+
+**/
+STATIC
+VOID
+RefreshDisplayStrings (
+  VOID
+  )
+{
+  CHAR8                                   Language[sizeof (mDisplayStringsLanguage)];
+  UINTN                                   Size;
+  EFI_STATUS                              Status;
+  EDKII_FORM_BROWSER_EXTENSION2_PROTOCOL  *FormBrowserEx2;
+
+  ZeroMem (Language, sizeof (Language));
+  Size   = sizeof (Language) - 1;
+  Status = gRT->GetVariable (L"PlatformLang", &gEfiGlobalVariableGuid, NULL, &Size, Language);
+  if (EFI_ERROR (Status) || (AsciiStrCmp (Language, mDisplayStringsLanguage) == 0)) {
+    return;
+  }
+
+  FreeDisplayStrings ();
+  InitializeDisplayStrings ();
+  CopyMem (mDisplayStringsLanguage, Language, sizeof (Language));
+
+  //
+  // The browser keeps its own copy of the hot key help, so it is replaced
+  // too.  The current form still shows the old text; the next one does not.
+  //
+  Status = gBS->LocateProtocol (&gEdkiiFormBrowserEx2ProtocolGuid, NULL, (VOID **)&FormBrowserEx2);
+  if (!EFI_ERROR (Status)) {
+    ReRegisterHotKey (FormBrowserEx2, SCAN_F10, BROWSER_ACTION_SUBMIT, 0, STRING_TOKEN (FUNCTION_TEN_STRING));
+    ReRegisterHotKey (FormBrowserEx2, SCAN_F9, BROWSER_ACTION_DEFAULT, EFI_HII_DEFAULT_CLASS_STANDARD, STRING_TOKEN (FUNCTION_NINE_STRING));
+  }
+}
