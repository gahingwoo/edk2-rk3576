+/**
+  Reload the HII strings if the platform language, or whether a touch screen
+  that types keys is present, has changed since they were loaded.
+
+**/
+VOID
+RefreshLibStrings (
+  VOID
+  )
+{
+  CHAR8       Language[sizeof (mLibStringsLanguage)];
+  UINTN       Size;
+  EFI_STATUS  Status;
+
+  ZeroMem (Language, sizeof (Language));
+  Size   = sizeof (Language) - 1;
+  Status = gRT->GetVariable (L"PlatformLang", &gEfiGlobalVariableGuid, NULL, &Size, Language);
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  if ((AsciiStrCmp (Language, mLibStringsLanguage) == 0) &&
+      (LibHasTouchKeys () == mLibStringsTouch))
+  {
+    return;
+  }
+
+  FreeLibStrings ();
+  InitializeLibStrings ();
+  CopyMem (mLibStringsLanguage, Language, sizeof (Language));
+}
