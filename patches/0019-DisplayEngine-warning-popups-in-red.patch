+//
+// Warning and error popups are white on red, so a question that cannot be
+// undone (Reset All Settings, deleting Secure Boot keys) stands out; an
+// informational popup keeps the normal popup colour.
+//
+STATIC UINTN  mPopupColor = 0;
+
+STATIC
+UINTN
+PopupColor (
+  VOID
+  )
+{
+  return (mPopupColor != 0) ? mPopupColor : GetPopupColor ();
+}
